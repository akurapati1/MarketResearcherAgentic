# --- LLM (optional; without a key the built-in heuristic engine is used) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Storage: SQLite by default, PostgreSQL for scale ---
DATABASE_URL=sqlite+aiosqlite:///./data/market_researcher.db
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/market

# --- Runtime ---
MAX_CONCURRENT_JOBS=4
MARKET_DATA_MODE=auto        # auto | live | synthetic
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=120
API_KEY=                     # if set, all /api calls need header X-API-Key
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
